[Unit]
Description=Custom PEAP-MSCHAPv2 RADIUS server
After=network-online.target winbind.service
Wants=network-online.target
Requires=winbind.service

[Service]
Type=simple
User=custom-radius
Group=custom-radius
SupplementaryGroups=winbindd_priv
WorkingDirectory=/opt/custom-radius
Environment=RADIUS_ENV=/etc/custom-radius/radius.env
ExecStart=/usr/bin/python3 /opt/custom-radius/custom_radius.py
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
# Auto-creates /var/lib/custom-radius (owned by User=/Group= above) and
# makes it writable under ProtectSystem=strict below, for the optional
# login-history SQLite database (RADIUS_STATE_DB).
StateDirectory=custom-radius
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# All three are required by ntlm_auth, which runs as a subprocess in
# this same cgroup and inherits these restrictions:
#   AF_UNIX    - the socket it uses to talk to winbindd. Without it,
#                ntlm_auth cannot reach winbindd at all and dies with
#                "could not obtain winbind separator" and a SIGSEGV /
#                SIGABRT, which surfaces here as every login rejected.
#   AF_NETLINK - getifaddrs() opens a netlink socket to enumerate
#                interfaces; without it Samba reports "Could not
#                determine network interfaces".
#   AF_INET    - the RADIUS listener itself.
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
