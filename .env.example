# RADIUS server configuration template. Copy to .env and fill in real values.
# Do not commit the real .env — it contains passwords and secrets.

# AD DNS domain, for example corp.example.com
AD_DOMAIN=
# AD short (NetBIOS) domain, for example CORP
AD_NETBIOS_DOMAIN=
# Domain controller FQDN and IP address
AD_DC_HOST=
AD_DC_IP=
# DNS servers supplied by this server's current network configuration; verify.
AD_DNS_SERVERS=
# Existing group allowed to use Wi-Fi (sAMAccountName).
# Use "-" in the test environment to allow every successfully authenticated AD account.
AD_ALLOWED_GROUP=

# Optional: account authorized to join this server to AD.
AD_JOIN_USER=
AD_JOIN_PASSWORD=

# Optional: read-only directory account for LDAPS group lookups.
AD_LDAP_BIND_USER=
AD_LDAP_BIND_PASSWORD=
AD_LDAP_CA_FILE=

# Actual source IP (or comma-separated IPs/CIDR ranges) of RADIUS requests
# (AP or controller), not a client IP. "*" allows any source.
RADIUS_CLIENT_IP=*
# Shared secret — must match the value configured on the AP/controller.
RADIUS_SHARED_SECRET=
# Interface the server listens on.
RADIUS_LISTEN_IP=127.0.0.1
RADIUS_AUTH_PORT=1812
WIFI_SSID=
AP_MODEL=
AP_HARDWARE_VERSION=
AP_FIRMWARE_VERSION=

# Name clients will validate in the RADIUS server certificate (CN/SAN).
RADIUS_SERVER_NAME=
# Certificate/key/CA bundle paths. If using a publicly trusted certificate,
# RADIUS_TLS_CERT_FILE must contain the FULL chain (leaf + intermediates).
RADIUS_TLS_CERT_FILE=
RADIUS_TLS_KEY_FILE=
RADIUS_TLS_CA_FILE=

# Optional dedicated low-privilege AD test account (not a domain admin).
AD_TEST_USER=
AD_TEST_PASSWORD=

# Derived AD settings used by the service and domain-join checks.
AD_REALM=
AD_BASE_DN=
AD_KDC_HOST=
AD_AUTH_BACKEND=winbind

# RADIUS protocol and local state.
RADIUS_ACCOUNTING_PORT=1813
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=true
RADIUS_SESSION_TTL_SECONDS=120
RADIUS_DUPLICATE_WINDOW_SECONDS=30
RADIUS_REQUEST_TIMEOUT_SECONDS=5
RADIUS_STATE_DB=/var/lib/custom-radius/state.db

# Initial EAP profile.
RADIUS_EAP_METHOD=PEAP-MSCHAPV2
RADIUS_TLS_MIN_VERSION=1.2
RADIUS_TLS_VERIFY_CLIENT=false

# Runtime and diagnostics.
RADIUS_LOG_LEVEL=INFO
RADIUS_LOG_AUTH_SUCCESSES=true
RADIUS_LOG_AUTH_FAILURES=true
RADIUS_LOG_CREDENTIALS=false

# Read-only web dashboard (admin_web.py). Change the password before use.
RADIUS_ADMIN_WEB_LISTEN_IP=127.0.0.1
RADIUS_ADMIN_WEB_PORT=8443
RADIUS_ADMIN_WEB_USER=admin
RADIUS_ADMIN_WEB_PASSWORD=
