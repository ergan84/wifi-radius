# RADIUS server configuration template. Copy to radius.env and fill in.
# Do not commit the real file — it contains the shared secret and passwords.
#
# Every key below is read by the code. Values needed only while joining the
# machine to the domain live in smb-radius.conf / krb5-radius.conf, not here.

# --- Active Directory -------------------------------------------------
# Short (NetBIOS) domain, for example EXAMPLE. Passed to ntlm_auth.
AD_NETBIOS_DOMAIN=
# Existing AD group allowed to use Wi-Fi (sAMAccountName).
# "-" allows every successfully authenticated account — test setups only.
AD_ALLOWED_GROUP=-

# --- RADIUS listener --------------------------------------------------
# Interface to listen on. Not 127.0.0.1 if requests come from a real AP.
RADIUS_LISTEN_IP=127.0.0.1
RADIUS_AUTH_PORT=1812
# Source IP(s) of RADIUS requests — the AP or controller, not the client.
# One IP, a comma-separated list, CIDR ranges, or "*" for any source.
RADIUS_CLIENT_IP=*
# Shared secret — must match the value configured on the AP/controller.
RADIUS_SHARED_SECRET=

# --- TLS for the PEAP tunnel -----------------------------------------
# RADIUS_TLS_CERT_FILE must contain the FULL chain (leaf + intermediates)
# when the certificate comes from a public CA: EAP supplicants do not
# fetch missing intermediates the way browsers do, and iOS will refuse
# the certificate without them.
RADIUS_TLS_CERT_FILE=
RADIUS_TLS_KEY_FILE=
# Private CA certificate — only used by gen_ios_profile.py, and only
# needed when the server certificate is not from a public CA.
RADIUS_TLS_CA_FILE=
# The name clients validate against the certificate CN/SAN. Must be a DNS
# name: iOS cannot match an IP address literal against TLSTrustedServerNames.
# It does not have to resolve in DNS — the supplicant only compares strings.
RADIUS_SERVER_NAME=

# The PEAP tunnel is pinned to TLS 1.2 in code and is not configurable:
# PEAPv0 derives its MPPE keys from the TLS 1.2 PRF, and TLS 1.3 has no
# standardised PEAPv0 binding.

# --- Protocol timings and local state ---------------------------------
RADIUS_SESSION_TTL_SECONDS=120
RADIUS_DUPLICATE_WINDOW_SECONDS=30
# How long to wait for ntlm_auth/winbind before giving up on one request.
RADIUS_REQUEST_TIMEOUT_SECONDS=5
# Requests handled in parallel. Each one may block for up to
# RADIUS_REQUEST_TIMEOUT_SECONDS in ntlm_auth, so this is the number of
# simultaneously slow authentications the server can absorb.
RADIUS_WORKER_THREADS=16

# The Message-Authenticator on every Access-Request is always verified and
# cannot be switched off. Credentials are never logged at any log level.
RADIUS_LOG_LEVEL=INFO

# --- Wi-Fi / iOS profile ----------------------------------------------
WIFI_SSID=
# Branding for the generated .mobileconfig (gen_ios_profile.py).
PROFILE_ORGANIZATION=
PROFILE_IDENTIFIER_PREFIX=com.example.radius

# --- Read-only web dashboard (admin_web.py) ---------------------------
# Keep this on localhost and reach it over an SSH tunnel unless you put
# HTTPS in front of it. Change the password before first use.
RADIUS_ADMIN_WEB_LISTEN_IP=127.0.0.1
RADIUS_ADMIN_WEB_PORT=8443
RADIUS_ADMIN_WEB_USER=admin
RADIUS_ADMIN_WEB_PASSWORD=
